{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Do NOT map runtime module specifiers (react, react/jsx-dev-runtime,
    // next/link, ...) to their .d.ts files here. Turbopack honors tsconfig
    // `paths` at bundle time, so such a mapping resolves the auto-injected JSX
    // runtime import to a type-only module -> jsxDEV is undefined -> every
    // client component throws "(void 0) is not a function". Webpack masks it;
    // Turbopack (the `next dev` default) does not. Keep only real aliases.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
