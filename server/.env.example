# Copy to .env only if you need to override defaults:  cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. Local development
# ─────────────────────────────────────────────────────────────────────────────
# Nothing is required. Generation runs through Ollama at the default local URL and
# the dev-bypass dashboard needs no login. Optional: skip Redis/Celery —
# DEJAQ_USE_CELERY=false
#
# Generation backend (Ollama, local or remote). Default is local:
# DEJAQ_OLLAMA_URL=http://127.0.0.1:11434

# ─────────────────────────────────────────────────────────────────────────────
# 2. External LLM providers (optional — only for hard-query routing)
# ─────────────────────────────────────────────────────────────────────────────
# Fernet key that encrypts workspace provider API keys stored in the DB. Required only
# before saving an OpenAI/Anthropic/Google credential. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up — losing it makes stored credentials unrecoverable.
# DEJAQ_CREDENTIAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Attachments — images and files on /v1/responses (optional)
# ─────────────────────────────────────────────────────────────────────────────
# All defaults shown. The image thresholds are swept over ~1.85M labelled pairs
# (docs/image-gate.md); do not hand-tune them. After changing any of them run
#   dejaq-admin cache purge-images --workspace <slug>
# — existing entries may carry fingerprints the new rules would never accept.

# Shared cap, applied to images AND files.
# DEJAQ_MAX_ATTACHMENT_BYTES=10485760      # 10 MB

# --- Image gate: photo path (CLIP + dHash). Both thresholds are load-bearing.
# DEJAQ_CACHE_IMAGE_MAX_DISTANCE=0.08      # max CLIP cosine distance
# DEJAQ_CACHE_IMAGE_MAX_HAMMING=15         # max dHash hamming distance
# DEJAQ_CACHE_IMAGE_MIN_TILE_VARIETY=10    # distinct dHashes over a 4x4 grid; below this the
#                                          # image is near-uniform and is refused outright

# --- Image gate: OCR routing (document vs photo vs refused).
# DEJAQ_CACHE_IMAGE_OCR_ENABLED=true       # false => every image takes the photo path
# DEJAQ_CACHE_IMAGE_OCR_MIN_CONFIDENCE=60  # mean confidence required to count as a document
# DEJAQ_CACHE_IMAGE_OCR_MIN_WORDS=6        # words at that confidence required to count as a document
# DEJAQ_CACHE_IMAGE_AMBIGUOUS_MIN_WORDS=4  # text found but read below the confidence floor =>
#                                          # never served, never stored (does NOT fall to pixels)

# --- Image gate: document matching. BOTH conditions must hold.
# DEJAQ_CACHE_IMAGE_TEXT_MIN_JACCARD=0.85  # OCR token overlap
# DEJAQ_CACHE_IMAGE_TEXT_MIN_SHARED_TOKENS=4  # shared-token floor before a ratio counts at all

# --- OCR engine. Documents need the tesseract binary; without it they degrade
# to the photo path (a warning is logged and start.sh warns at boot).
# DEJAQ_TESSERACT_BIN=tesseract
# DEJAQ_TESSERACT_LANGS=heb+eng
# DEJAQ_OCR_TIMEOUT_SECONDS=20

# --- File attachments (PDF via pypdf; DOCX via python-docx, paragraphs/tables
# only; Markdown/text/code files by UTF-8 content sniff). This is NOT a
# caching-only switch: set it false and an attached file is never extracted and
# never reaches the provider either: the request is answered as if nothing had
# been attached. Images have no equivalent switch; they are always processed.
# DEJAQ_CACHE_FILE_ENABLED=true

# --- File gate. Exact sha256 of the whitespace-normalised extracted text — no
# thresholds to tune, false merges impossible by construction.
# DEJAQ_CACHE_FILE_MIN_CHARS=200           # applies to PDF/DOCX only, where extraction
#                                          # can fail silently (scanned/corrupt/encrypted)
#                                          # => never served, never stored. Text/Markdown/
#                                          # code files have no floor.

# Full list of advanced/runtime tuning vars (model backends, Chroma/Redis hosts,
# eviction floor, log levels, etc.) is documented in CLAUDE.md.
